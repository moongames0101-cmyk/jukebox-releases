{
  "manifest_version": 3,
  "name": "Gel for YouTube",
  "version": "1.0.0",
  "description": "Puts the YouTube theme you pick in Gel onto youtube.com.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "exclude_matches": ["*://www.youtube.com/embed/*"],
      "js": ["fx-engine.js", "yt-core.js", "gel-yt.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["theme.json", "fonts/*", "media/*"], "matches": ["*://www.youtube.com/*"] }
  ]
}
